{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rheinwerk-mes/boundary/v1.0/gl-posting-out",
  "title": "Buchung ausgehend (GL postings out) — Vertrag v1.0",
  "description": "Bestandswertbuchung aus einer Lagerbewegung, abgebildet auf Gruppen-ERP-Konten (URS-W3-012). Das MES führt kein Hauptbuch; Soll und Haben sind je Nachricht ausgeglichen.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "message_type",
    "message_id",
    "sender",
    "posting_date",
    "voucher",
    "warehouse",
    "currency",
    "lines"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0"
    },
    "message_type": {
      "type": "string",
      "const": "gl-posting-out"
    },
    "message_id": {
      "type": "string",
      "pattern": "[A-Z0-9][A-Z0-9-]{2,63}"
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "posting_date": {
      "type": "string",
      "format": "date"
    },
    "voucher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doctype", "name"],
      "properties": {
        "doctype": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stock_ledger_entry": {
          "type": "string"
        }
      }
    },
    "warehouse": {
      "type": "string",
      "minLength": 1
    },
    "item_code": {
      "type": "string",
      "minLength": 1
    },
    "batch_no": {
      "type": ["string", "null"]
    },
    "quantity": {
      "type": "number"
    },
    "uom": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "[A-Z]{3}"
    },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["account", "debit", "credit"],
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1
          },
          "debit": {
            "type": "number",
            "minimum": 0
          },
          "credit": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
